// User model — owned by the consumer because Prisma requires it to
// declare every back-relation it participates in. Add your business
// back-refs here (e.g. `posts Post[]`, `org Org @relation(...)`).

model User {
  id            String    @id @default(cuid())
  name          String?
  // `citext` — case-insensitive text. Both `credentialsProvider` and
  // `createRegisterHandler` in aiden-auth look users up with
  // `findUnique({ where: { email } })` on the raw string, and neither
  // normalises it. On a plain `text` column that makes login
  // case-sensitive, so `Owner@globex.test` fails to find
  // `owner@globex.test` and the caller is told the *password* is wrong —
  // `authorize` returns null for "not found" and "bad password" alike.
  // It also lets two accounts differ only in capitalisation, since the
  // unique constraint would see them as distinct.
  //
  // Fixing it in the column rather than at one call site means every
  // lookup is covered — login, registration's duplicate check, and
  // anything written later — and the unique index becomes
  // case-insensitive along with it.
  email         String    @unique @db.Citext
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]
  roles    Role[]    @relation("UserRoles")

  // DeskLine back-relations. `tickets` is named because Ticket.owner
  // declares @relation("TicketOwner"); AIUsage is deliberately absent —
  // it is denormalized and holds no foreign key (see aiusage.prisma).
  memberships Membership[]
  tickets     Ticket[]     @relation("TicketOwner")

  @@map("users")
}
