  @@index([orgId])
  @@index([userId])
  @@index([createdAt])
}

// ─── prisma\fragments\membership.prisma ───
// Membership — join table granting a User a role within an Org.
// role is a free-text string: "owner" | "agent" | "viewer".
//   owner:  members.manage + ticket.manage (all org tickets)
//   agent:  ticket.manage (all org tickets), no member management
//   viewer: read-only across the org's tickets

model Membership {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      String
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId])
}

// ─── prisma\fragments\org.prisma ───
// Org — the tenant boundary for DeskLine. Every Ticket and Membership
// is scoped to exactly one Org; queries always filter by orgId derived
// from the requester's own Membership row, never from client input.

model Org {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  tickets     Ticket[]
}

// ─── prisma\fragments\ticket.prisma ───
// Ticket — org-scoped support ticket. `ownerId` is the creator/assignee;
// named distinctly from `userId` because aiden-security's assertOwnership()
// expects a `userId` field, so routes pass it a shaped
// `{ id: ticket.id, userId: ticket.ownerId }` view rather than the raw row.

model Ticket {
  id        String   @id @default(cuid())
  orgId     String
  ownerId   String
  subject   String
  body      String
  status    String   @default("open") // open | pending | closed
  priority  String?
  category  String?
  sentiment String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner     User     @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([ownerId])
  @@index([orgId, status])
}

